{
  "manifest_version": 3,
  "name": "r3dProxy Companion",
  "version": "0.1.0",
  "description": "Live recon, scanning, secrets and intercept through your local r3dProxy — for authorized testing.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "r3dProxy Companion"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "browser_specific_settings": {
    "gecko": { "id": "r3dproxy@0x1ray", "strict_min_version": "109.0" }
  }
}
